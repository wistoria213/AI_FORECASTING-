"""
ARGUS V3 — OpenAI-Compatible Forecasting Endpoint
===================================================
Exposes POST /v1/chat/completions that the hackathon evaluation harness can query.

Usage:
    python server.py          # starts on port 8000
    PORT=8080 python server.py

The harness sends a question in the last user message.
ARGUS extracts signals from the question text, runs the 5-layer pipeline,
and returns a probability forecast as the assistant reply.

Response format (per OpenAI spec):
{
  "id": "...",
  "object": "chat.completion",
  "choices": [{
    "message": {
      "role": "assistant",
      "content": "<JSON with point, ci_lower, ci_upper, reasoning>"
    }
  }]
}
"""

import os
import json
import time
import uuid
import re
import numpy as np
from flask import Flask, request, jsonify

# Import ARGUS engine (same directory)
from argus_v3_complete import ARGUSv3, Signal

app = Flask(__name__)


# ─── Signal extraction from natural-language question ────────────────────────

def extract_signals_from_question(question_text: str) -> list[Signal]:
    """
    Parse the question for any numeric/keyword hints that act as signals.
    Falls back to a neutral prior signal set if nothing found.
    """
    signals = []
    np.random.seed(hash(question_text) % 2**31)  # deterministic per question

    text_lower = question_text.lower()

    # Keyword → anomaly score mapping
    KEYWORD_SCORES = {
        "insider": 2.5, "trade": 1.8, "sec filing": 2.2, "short": 2.0,
        "patent": 1.5, "acquisition": 2.8, "merger": 2.7, "bankruptcy": 3.0,
        "fda": 2.4, "approval": 2.1, "reject": 2.6, "lawsuit": 2.3,
        "earnings": 1.9, "miss": 2.0, "beat": 1.7, "layoff": 2.4,
        "ceo": 2.0, "resign": 2.5, "fraud": 3.2, "recall": 2.8,
        "election": 1.6, "regulation": 1.5, "ban": 2.0, "sanction": 2.2,
    }

    base_anomaly = 0.8  # neutral
    t = 0.0
    for kw, score in KEYWORD_SCORES.items():
        if kw in text_lower:
            # Each keyword match → one signal
            signals.append(Signal(
                timestamp=round(t, 2),
                anomaly_score=score + np.random.normal(0, 0.2),
                signal_type="keyword_match",
                actor_id=kw,
                magnitude=1.0,
            ))
            t += np.random.uniform(0.5, 3.0)

    # Always add 3–6 baseline signals (represents background trading data)
    for i in range(np.random.randint(3, 7)):
        signals.append(Signal(
            timestamp=round(t + i * np.random.uniform(1, 5), 2),
            anomaly_score=base_anomaly + np.random.normal(0, 0.4),
            signal_type="baseline",
            actor_id=f"market_{i}",
            magnitude=1.0,
        ))

    return signals


# ─── Core forecast logic ─────────────────────────────────────────────────────

def run_argus_forecast(question_text: str) -> dict:
    """Run full ARGUS pipeline on a question. Returns forecast dict."""
    argus = ARGUSv3()

    signals = extract_signals_from_question(question_text)
    for s in signals:
        argus.ingest_signal(s)

    # Add conformal calibration residuals
    for s in argus.signals[-20:]:
        predicted = argus.layer1_hawkes.intensity(s.timestamp)
        actual = predicted * (1 + s.anomaly_score / 10)
        argus.layer4_conformal.add_residual(predicted, actual)
    argus.layer4_conformal.fit_threshold()

    forecast = argus.forecast(horizon_days=90)
    diag = argus.calibration_report()

    return {
        "probability": round(float(forecast.point_estimate), 4),
        "ci_lower": round(float(forecast.ci_lower), 4),
        "ci_upper": round(float(forecast.ci_upper), 4),
        "confidence_interval": "90%",
        "hawkes_intensity": round(float(forecast.hawkes_intensity), 4),
        "n_signals": len(argus.signals),
        "hawkes_kappa": round(float(diag.get("hawkes_kappa") or 0), 4),
        "filter_confidence": round(float(diag["filter_confidence"]), 4),
        "reasoning": (
            f"ARGUS V3 forecast using {len(argus.signals)} signals. "
            f"Hawkes self-excitement κ={diag.get('hawkes_kappa', 0):.3f}, "
            f"current intensity={forecast.hawkes_intensity:.3f}. "
            f"Conformal 90% CI: [{forecast.ci_lower:.3f}, {forecast.ci_upper:.3f}]. "
            f"Point estimate: {forecast.point_estimate:.3f}."
        ),
    }


# ─── OpenAI-compatible endpoints ─────────────────────────────────────────────

@app.route("/v1/chat/completions", methods=["POST"])
def chat_completions():
    data = request.get_json(force=True)
    messages = data.get("messages", [])

    # Extract the last user message as the question
    question = ""
    for msg in reversed(messages):
        if msg.get("role") == "user":
            content = msg.get("content", "")
            if isinstance(content, list):
                question = " ".join(
                    c.get("text", "") for c in content if isinstance(c, dict)
                )
            else:
                question = str(content)
            break

    if not question:
        question = "Will this event occur?"

    try:
        result = run_argus_forecast(question)
        reply_content = json.dumps(result, indent=2)
    except Exception as e:
        reply_content = json.dumps({"error": str(e), "probability": 0.5})

    response = {
        "id": f"argus-{uuid.uuid4().hex[:12]}",
        "object": "chat.completion",
        "created": int(time.time()),
        "model": "argus-v3",
        "choices": [
            {
                "index": 0,
                "message": {
                    "role": "assistant",
                    "content": reply_content,
                },
                "finish_reason": "stop",
            }
        ],
        "usage": {
            "prompt_tokens": len(question.split()),
            "completion_tokens": len(reply_content.split()),
            "total_tokens": len(question.split()) + len(reply_content.split()),
        },
    }
    return jsonify(response)


@app.route("/v1/models", methods=["GET"])
def list_models():
    """OpenAI-compatible model listing"""
    return jsonify({
        "object": "list",
        "data": [{
            "id": "argus-v3",
            "object": "model",
            "created": 1700000000,
            "owned_by": "argus-team",
        }]
    })


@app.route("/health", methods=["GET"])
def health():
    return jsonify({"status": "ok", "model": "argus-v3"})


